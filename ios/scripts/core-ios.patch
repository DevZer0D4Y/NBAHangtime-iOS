+	}
+	if (!hangtime_fixed)
+	{
+		hangtime_apply_fixes();
+		hangtime_fixed = 1;
+	}
+	hangtime_update_heads((INT16)HT_RAM(HT_DTYPE) > 0 && HT_RAM(HT_GNDSTAT));
+	if (hangtime_requested != hangtime_wide)
+		hangtime_apply_widescreen();
+#endif
 }
