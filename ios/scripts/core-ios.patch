 }
 
+#ifdef drv_hangtime
+/* Beam position on a given width: Hangtime's screen is wider than the arcade's for widescreen. */
+int cpu_gethorzbeampos_width(int width)
+{
+	double elapsed_time = timer_timeelapsed(refresh_timer);
+	int scanline = (int)(elapsed_time * scanline_period_inv);
+	double time_since_scanline = elapsed_time - (double)scanline * scanline_period;
+	return (int)(time_since_scanline * scanline_period_inv * (double)width);
+}
+#endif
+
 
 
